# App environment for non-production builds: omit or `dev` for local dev conveniences (default when unset).
# Set `prod` to mirror production behavior while running electron-vite dev. Production builds always embed `prod`.
# KAJO_APP_ENV=prod

# Electron: enable DevTools, View menu, auto-open detached DevTools, and “Inspect Element” in context menu (also enabled in electron-vite dev).
# KAJO_DEBUG_TOOLS=1
# Packaged support builds only — must be set together with KAJO_DEBUG_TOOLS=1:
# KAJO_SUPPORT_BUILD=1

# Skip automatic pinned-binary download before `pnpm dev` / `pnpm start` (uses `scripts/fetch-binaries.mjs` when yt-dlp/ffmpeg are missing).
# KAJO_SKIP_DEV_BINARIES=1

# Project homepage URL — baked at build time into the desktop bundle and used for the
# openExternal HTTPS allowlist (host + subdomains). Must be https: with a real host.
# KAJO_WEBSITE_URL=https://github.com/adamrefaey/kajo-downloader

# Auto-update (packaged app): optional HTTPS generic feed URL; overrides app-update.yml from the build
# KAJO_AUTO_UPDATE_FEED_URL=https://releases.example.com/desktop
# KAJO_DISABLE_AUTO_UPDATE=1

# Optional remote error reporting (Sentry-compatible HTTPS DSN). Unset = local logs only (v1 default).
# KAJO_SENTRY_DSN=https://oXXXX.ingest.sentry.io/YYYY

# Optional crash dump upload URL for Electron crashReporter. Unset = local dumps only.
# KAJO_CRASH_REPORTER_URL=https://example.com/crash-reports

# Main-process log level: error | warn | info | debug (default: info in prod, debug in dev).
# KAJO_MAIN_LOG_LEVEL=info

# Override Electron userData root (tests / portable). Absolute path.
# Session → <userData>/session, logs → <userData>/logs.
# Defaults: kajo-downloader (packaged) / kajo-downloader-dev (unpackaged).
# KAJO_USER_DATA=/tmp/kajo-userdata
