{
    "extends": ["@electron-toolkit/tsconfig/tsconfig.node.json", "./tsconfig.base.json"],
    "include": [
        "electron.vite.config.*",
        "viteReactWithCompiler.*",
        "electron/**/*",
        "src/main/**/*",
        "src/preload/**/*",
        "src/types/**/*",
        "src/shared/**/*.ts",
        "src/i18n/**/*.ts",
        "tests/**/*.ts"
    ],
    "exclude": ["vitest.config.ts", "tests/renderer"],
    "compilerOptions": {
        "composite": true,
        "declaration": true,
        "isolatedDeclarations": true,
        "types": ["electron-vite/node", "vitest/globals"],
        "target": "ES2024",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2024", "DOM"]
    }
}
