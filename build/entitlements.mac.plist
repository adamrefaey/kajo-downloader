<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Chromium / V8 JIT (required for Electron). -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!--
      Bundled yt-dlp / ffmpeg / Deno run as separate spawn() children, not loaded into the
      Electron process — so disable-library-validation and allow-dyld-environment-variables
      are not required and are omitted to reduce notarization scrutiny.
    -->
  </dict>
</plist>
