{
    "extends": ["@electron-toolkit/tsconfig/tsconfig.web.json", "./tsconfig.base.json"],
    "include": [
        "src/renderer/src/env.d.ts",
        "src/renderer/src/**/*",
        "src/renderer/src/**/*.tsx",
        "src/preload/*.d.ts",
        "src/store/**/*",
        "src/types/**/*",
        "src/shared/**/*.ts",
        "src/i18n/**/*.ts",
        "src/i18n/**/*.json",
        "tests/**/*.tsx",
        "tests/renderer/**/*.ts",
        "tests/**/*.d.ts"
    ],
    "compilerOptions": {
        "composite": true,
        "declaration": true,
        "isolatedDeclarations": true,
        "types": ["vite/client", "@testing-library/jest-dom", "vitest/globals"],
        "jsx": "react-jsx",
        "target": "ES2024",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "paths": {
            "@renderer/*": ["./src/renderer/src/*"],
            "@resources/*": ["./resources/*"]
        }
    }
}
